class HealthPotion:
    def use(self):
        print("You regain 50 HP!")
class ManaPotion:
    def use(self):
        print("You regain 30 MP!")
class SpeedPotion:
    def use(self):
        print("Your speed increases for 10 seconds!")

health_potion1 = HealthPotion()
mana_potion1 = ManaPotion()
speed_potion1 = SpeedPotion()

items = [health_potion1, mana_potion1, speed_potion1]
def apply_item(item):
    item.use()
for item in items:
    apply_item(item)